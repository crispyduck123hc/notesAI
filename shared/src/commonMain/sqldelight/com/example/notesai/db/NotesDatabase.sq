-- Folders form a tree (adjacency list). parentId NULL == the root folder.
-- `uuid` is the cross-device identity; `updatedAt`/`deletedAt` drive future sync.
CREATE TABLE FolderEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    parentId INTEGER REFERENCES FolderEntity(id) ON DELETE CASCADE,
    sortOrder INTEGER NOT NULL DEFAULT 0,
    uuid TEXT NOT NULL DEFAULT '',
    updatedAt INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER
);

CREATE UNIQUE INDEX FolderEntity_uuid ON FolderEntity(uuid);

-- Notes live in exactly one folder.
CREATE TABLE NoteEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    folderId INTEGER NOT NULL REFERENCES FolderEntity(id) ON DELETE CASCADE,
    uuid TEXT NOT NULL DEFAULT '',
    updatedAt INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER,
    -- Set on keep-both conflict copies: points at the note they diverged from.
    conflictOf TEXT
);

CREATE UNIQUE INDEX NoteEntity_uuid ON NoteEntity(uuid);

-- App-level key/value metadata (e.g. this install's stable deviceId).
CREATE TABLE AppMetadata (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- ---- Sync bookkeeping -----------------------------------------------------
-- will read and write. See shared/src/commonMain/sqldelight/README.md.

-- Local changes that still need pushing to the remote (durable outbox).
-- Keyed by entity so repeated edits coalesce into a single pending push.
CREATE TABLE SyncOutbox (
    entityType TEXT NOT NULL,
    entityUuid TEXT NOT NULL,
    enqueuedAt INTEGER NOT NULL,
    attempts INTEGER NOT NULL DEFAULT 0,
    lastError TEXT,
    PRIMARY KEY (entityType, entityUuid)
);

-- Last remote revision we synced per record; the baseline that makes conflict
-- detection possible (local changed? remote changed? both?).
CREATE TABLE SyncBaseline (
    entityType TEXT NOT NULL,
    entityUuid TEXT NOT NULL,
    remoteFileId TEXT,
    remoteRevisionId TEXT,
    lastSyncedAt INTEGER NOT NULL,
    PRIMARY KEY (entityType, entityUuid)
);

-- Incremental pull position, keyed by backend (e.g. 'google-drive').
CREATE TABLE SyncState (
    backend TEXT NOT NULL PRIMARY KEY,
    startPageToken TEXT,
    lastPulledAt INTEGER
);

-- Durable queue of conflicts that need a human decision, so a conflict detected
-- while the app is closed is never lost.
CREATE TABLE ConflictInbox (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    entityType TEXT NOT NULL,
    entityUuid TEXT NOT NULL,
    kind TEXT NOT NULL,
    localRevision TEXT,
    remoteRevision TEXT,
    detectedAt INTEGER NOT NULL,
    resolvedAt INTEGER,
    resolution TEXT,
    conflictCopyUuid TEXT
);

-- ---- GitHub integration ---------------------------------------------------
-- A linked repository (the folder in the tree), and the local mirror of its issues.
--
-- These are deliberately *separate* from NoteEntity/FolderEntity. Drive sync projects
-- everything in NoteEntity into the user's Drive app-data folder, so a GitHub note must never
-- be a row in it: the GitHub folder is self-contained by construction rather than by
-- remembering to exclude a flag in the sync engine. Nothing in NoteRepository or
-- NoteSyncEngine reads or writes these tables.
--
-- The model is explicit pull/push, so there is no outbox here: `dirty` just means "edited
-- since the last pull or push", and the user's push button decides when that travels.
CREATE TABLE GitHubRepoEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    owner TEXT NOT NULL,
    name TEXT NOT NULL,
    installationId INTEGER NOT NULL,
    linkedAt INTEGER NOT NULL
);

CREATE UNIQUE INDEX GitHubRepoEntity_owner_name ON GitHubRepoEntity(owner, name);

-- One row per issue. `number` is the issue number: stable per repository, and the identity
-- of the row (never the local `id`, which is only meaningful on this device).
CREATE TABLE GitHubIssueNoteEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    repoId INTEGER NOT NULL REFERENCES GitHubRepoEntity(id) ON DELETE CASCADE,
    number INTEGER NOT NULL,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    -- 'open' or 'closed'. Pulled from GitHub; this app never deletes an issue.
    state TEXT NOT NULL,
    -- What GitHub reported when this row was last pulled or pushed. A different value on the
    -- remote means the issue moved underneath a local edit, which push reports instead of
    -- overwriting.
    remoteUpdatedAt TEXT NOT NULL,
    -- 0/1: edited locally, not yet pushed.
    dirty INTEGER NOT NULL DEFAULT 0,
    pulledAt INTEGER NOT NULL
);

CREATE UNIQUE INDEX GitHubIssueNoteEntity_repo_number ON GitHubIssueNoteEntity(repoId, number);

-- ---- Folders --------------------------------------------------------------

selectAllFolders:
SELECT * FROM FolderEntity WHERE deletedAt IS NULL ORDER BY name;

selectChildFolders:
SELECT * FROM FolderEntity WHERE parentId = ? AND deletedAt IS NULL ORDER BY name;

insertFolder:
INSERT INTO FolderEntity(name, parentId, sortOrder, uuid, updatedAt)
VALUES (?, ?, 0, ?, ?);

-- The root row has a fixed id and a fixed uuid so every device agrees on it.
insertRootFolder:
INSERT OR IGNORE INTO FolderEntity(id, name, parentId, sortOrder, uuid, updatedAt)
VALUES (1, 'root', NULL, 0, ?, ?);

renameFolder:
UPDATE FolderEntity SET name = ?, updatedAt = ? WHERE id = ?;

-- Soft delete (tombstone): the row stays for sync to propagate the deletion.
softDeleteFolderById:
UPDATE FolderEntity SET deletedAt = ?, updatedAt = ? WHERE id = ?;

-- ---- Notes ----------------------------------------------------------------

selectAllNotes:
SELECT * FROM NoteEntity WHERE deletedAt IS NULL ORDER BY title;

selectNoteById:
SELECT * FROM NoteEntity WHERE id = ? AND deletedAt IS NULL;

selectNotesInFolder:
SELECT * FROM NoteEntity WHERE folderId = ? AND deletedAt IS NULL ORDER BY title;

insertNote:
INSERT INTO NoteEntity(title, content, createdAt, folderId, uuid, updatedAt, conflictOf)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateNote:
UPDATE NoteEntity SET title = ?, content = ?, updatedAt = ? WHERE id = ?;

-- Soft delete (tombstone): the row stays for sync to propagate the deletion.
softDeleteNoteById:
UPDATE NoteEntity SET deletedAt = ?, updatedAt = ? WHERE id = ?;

softDeleteNotesInFolder:
UPDATE NoteEntity SET deletedAt = ?, updatedAt = ? WHERE folderId = ? AND deletedAt IS NULL;

-- ---- App metadata ---------------------------------------------------------

selectMetadata:
SELECT value FROM AppMetadata WHERE key = ?;

upsertMetadata:
INSERT OR REPLACE INTO AppMetadata(key, value) VALUES (?, ?);

deleteMetadata:
DELETE FROM AppMetadata WHERE key = ?;

-- ---- Sync: outbox ---------------------------------------------------------

enqueueOutbox:
INSERT OR REPLACE INTO SyncOutbox(entityType, entityUuid, enqueuedAt, attempts, lastError)
VALUES (?, ?, ?, 0, NULL);

selectOutbox:
SELECT * FROM SyncOutbox ORDER BY enqueuedAt;

deleteOutbox:
DELETE FROM SyncOutbox WHERE entityType = ? AND entityUuid = ?;

recordOutboxAttempt:
UPDATE SyncOutbox
SET attempts = attempts + 1, lastError = ?
WHERE entityType = ? AND entityUuid = ?;

-- ---- Sync: baseline -------------------------------------------------------

upsertBaseline:
INSERT OR REPLACE INTO SyncBaseline(entityType, entityUuid, remoteFileId, remoteRevisionId, lastSyncedAt)
VALUES (?, ?, ?, ?, ?);

selectBaseline:
SELECT * FROM SyncBaseline WHERE entityType = ? AND entityUuid = ?;

selectAllBaselines:
SELECT * FROM SyncBaseline;

deleteBaseline:
DELETE FROM SyncBaseline WHERE entityType = ? AND entityUuid = ?;
-- ---- Sync: pull cursor ----------------------------------------------------

upsertSyncState:
INSERT OR REPLACE INTO SyncState(backend, startPageToken, lastPulledAt)
VALUES (?, ?, ?);

selectSyncState:
SELECT * FROM SyncState WHERE backend = ?;

-- ---- Sync: conflict inbox -------------------------------------------------

insertConflict:
INSERT INTO ConflictInbox(entityType, entityUuid, kind, localRevision, remoteRevision, detectedAt)
VALUES (?, ?, ?, ?, ?, ?);

selectUnresolvedConflicts:
SELECT * FROM ConflictInbox WHERE resolvedAt IS NULL ORDER BY detectedAt;

resolveConflict:
UPDATE ConflictInbox
SET resolvedAt = ?, resolution = ?, conflictCopyUuid = ?
WHERE id = ?;

-- ---- Sync support --------------------------------------------------------

-- Lookups by uuid (remote events reference uuids, never local row ids).
selectFolderById:
SELECT * FROM FolderEntity WHERE id = ?;

selectFolderByUuid:
SELECT * FROM FolderEntity WHERE uuid = ?;

selectNoteByUuid:
SELECT * FROM NoteEntity WHERE uuid = ?;

-- Upserts used when applying a remote change. Unlike the local mutation queries
-- these never enqueue outbox work: the change already exists remotely.
insertNoteFromRemote:
INSERT INTO NoteEntity(uuid, title, content, createdAt, folderId, updatedAt, deletedAt, conflictOf)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateNoteFromRemote:
UPDATE NoteEntity
SET title = ?, content = ?, createdAt = ?, folderId = ?, updatedAt = ?, deletedAt = ?, conflictOf = ?
WHERE uuid = ?;

insertFolderFromRemote:
INSERT INTO FolderEntity(uuid, name, parentId, sortOrder, updatedAt, deletedAt)
VALUES (?, ?, ?, 0, ?, ?);

updateFolderFromRemote:
UPDATE FolderEntity
SET name = ?, parentId = ?, updatedAt = ?, deletedAt = ?
WHERE uuid = ?;

selectUnresolvedConflict:
SELECT * FROM ConflictInbox
WHERE entityType = ? AND entityUuid = ? AND resolvedAt IS NULL
ORDER BY detectedAt DESC
LIMIT 1;

selectConflictById:
SELECT * FROM ConflictInbox WHERE id = ?;

-- ---- Tombstone GC ---------------------------------------------------------

selectPurgeableNotes:
SELECT * FROM NoteEntity WHERE deletedAt IS NOT NULL AND deletedAt < ?;

selectPurgeableFolders:
SELECT * FROM FolderEntity WHERE deletedAt IS NOT NULL AND deletedAt < ?;

deleteNoteByUuid:
DELETE FROM NoteEntity WHERE uuid = ?;

deleteFolderByUuid:
DELETE FROM FolderEntity WHERE uuid = ?;

selectOutboxEntry:
SELECT * FROM SyncOutbox WHERE entityType = ? AND entityUuid = ?;

moveNote:
UPDATE NoteEntity SET folderId = ?, updatedAt = ? WHERE id = ?;

-- Id of the row inserted by the most recent INSERT on this connection
lastInsertRowId:
SELECT CAST(last_insert_rowid() AS INTEGER) AS id;

-- ---- GitHub: linked repositories and the issue mirror ----------------------
--
-- Deliberately no `ON CONFLICT ... DO UPDATE` (SQLDelight's grammar rejects it): the repository
-- chooses between insert and update, which is also where the "never overwrite unpushed edits" rule
-- belongs, so it can be tested rather than inferred from SQL.

insertGitHubRepo:
INSERT INTO GitHubRepoEntity(owner, name, installationId, linkedAt)
VALUES (?, ?, ?, ?);

updateGitHubRepoInstallation:
UPDATE GitHubRepoEntity SET installationId = ? WHERE id = ?;

selectGitHubRepoById:
SELECT * FROM GitHubRepoEntity WHERE id = ?;

selectGitHubRepoByOwnerName:
SELECT * FROM GitHubRepoEntity WHERE owner = ? AND name = ?;

selectAllGitHubRepos:
SELECT * FROM GitHubRepoEntity ORDER BY owner, name;

deleteGitHubRepo:
DELETE FROM GitHubRepoEntity WHERE id = ?;

selectGitHubIssues:
SELECT * FROM GitHubIssueNoteEntity WHERE repoId = ? ORDER BY number;

selectGitHubIssue:
SELECT * FROM GitHubIssueNoteEntity WHERE repoId = ? AND number = ?;

insertGitHubIssue:
INSERT INTO GitHubIssueNoteEntity(repoId, number, title, body, state, remoteUpdatedAt, dirty, pulledAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- What a pull writes into a row that already exists. `dirty` is set to 0 because the caller only
-- takes this path when it has decided the row may be overwritten.
updateGitHubIssueFromPull:
UPDATE GitHubIssueNoteEntity
SET title = ?, body = ?, state = ?, remoteUpdatedAt = ?, dirty = 0, pulledAt = ?
WHERE repoId = ? AND number = ?;

markGitHubIssueDirty:
UPDATE GitHubIssueNoteEntity SET title = ?, body = ?, dirty = 1 WHERE repoId = ? AND number = ?;

-- Push succeeded: adopt GitHub's response as the new baseline and clear the local edit flag.
markGitHubIssueClean:
UPDATE GitHubIssueNoteEntity
SET title = ?, body = ?, state = ?, remoteUpdatedAt = ?, dirty = 0
WHERE repoId = ? AND number = ?;

-- Completion changed on GitHub while a local text edit is still pending: take the state and the new
-- timestamp, but keep the local text so the pending edit is not lost.
markGitHubIssueState:
UPDATE GitHubIssueNoteEntity
SET state = ?, remoteUpdatedAt = ?
WHERE repoId = ? AND number = ?;

deleteGitHubIssue:
DELETE FROM GitHubIssueNoteEntity WHERE repoId = ? AND number = ?;

deleteGitHubIssuesForRepo:
DELETE FROM GitHubIssueNoteEntity WHERE repoId = ?;
